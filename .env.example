# На Netlify вручную задайте только адрес сайта.
SITE_URL=http://localhost:3000

# Необязательно: без этой переменной используется gpt-4.1-mini.
# AI_MODEL=gpt-4.1-mini

# OPENAI_API_KEY и OPENAI_BASE_URL выдаёт Netlify AI Gateway автоматически.
# Не создавайте их вручную: это отключает автоматическую настройку.
# Для локального ИИ используйте netlify dev после link и production-деплоя.
